<%- include('partials/header') %>
<div class="page-header">
  <h1>Join the Hub</h1>
  <p>Create your account. You'll set up your parenting/mentor profile right after.</p>
</div>
<div class="card" style="max-width:480px;">
  <% if (error) { %><div class="alert error"><%= error %></div><% } %>
  <form method="POST" action="/register">
    <div class="grid grid-2" style="gap:12px;">
      <div>
        <label for="first_name">First name</label>
        <input type="text" id="first_name" name="first_name" value="<%= form.first_name || '' %>" required>
      </div>
      <div>
        <label for="last_name">Last name</label>
        <input type="text" id="last_name" name="last_name" value="<%= form.last_name || '' %>" required>
      </div>
    </div>
    <label for="email">Email</label>
    <input type="email" id="email" name="email" value="<%= form.email || '' %>" required>
    <label for="password">Password</label>
    <input type="password" id="password" name="password" required minlength="8">
    <div class="form-hint">At least 8 characters.</div>
    <label for="confirm_password">Confirm password</label>
    <input type="password" id="confirm_password" name="confirm_password" required minlength="8">

    <label>I am joining as a...</label>
    <div class="checkbox-group">
      <label class="inline"><input type="radio" name="role" value="student_parent" <%= form.role !== 'mentor' ? 'checked' : '' %>> Student parent looking for support</label>
      <label class="inline"><input type="radio" name="role" value="mentor" <%= form.role === 'mentor' ? 'checked' : '' %>> Mentor (current/former student parent willing to mentor)</label>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn">Create Account</button>
    </div>
  </form>
  <p style="margin-top:16px; font-size:0.88rem;">Already have an account? <a href="/login">Log in</a></p>
</div>
<%- include('partials/footer') %>
