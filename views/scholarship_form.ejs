<%- include('partials/header') %>
<div class="page-header"><h1><%= title %></h1></div>
<div class="card" style="max-width:560px;">
  <% if (error) { %><div class="alert error"><%= error %></div><% } %>
  <form method="POST" action="/scholarships/new">
    <label for="title">Title</label>
    <input type="text" id="title" name="title" value="<%= scholarship.title || '' %>" required>
    <label for="provider">Provider</label>
    <input type="text" id="provider" name="provider" value="<%= scholarship.provider || '' %>">
    <label for="description">Description</label>
    <textarea id="description" name="description"><%= scholarship.description || '' %></textarea>
    <div class="grid grid-2" style="gap:12px;">
      <div>
        <label for="amount">Amount</label>
        <input type="text" id="amount" name="amount" value="<%= scholarship.amount || '' %>" placeholder="e.g. $1,000 - $3,000">
      </div>
      <div>
        <label for="deadline">Deadline</label>
        <input type="text" id="deadline" name="deadline" value="<%= scholarship.deadline || '' %>" placeholder="e.g. March 1, 2027">
      </div>
    </div>
    <label for="eligibility_tags">Eligibility tags (comma-separated)</label>
    <input type="text" id="eligibility_tags" name="eligibility_tags" value="<%= scholarship.eligibility_tags || '' %>" placeholder="student_parent,single_parent,transfer">
    <label for="link">Link</label>
    <input type="text" id="link" name="link" value="<%= scholarship.link || '' %>" placeholder="https://...">
    <div class="form-actions">
      <button type="submit" class="btn">Save Scholarship</button>
      <a href="/scholarships" class="btn ghost">Cancel</a>
    </div>
  </form>
</div>
<%- include('partials/footer') %>
