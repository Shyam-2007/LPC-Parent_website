<%- include('partials/header') %>
<div class="page-header"><h1><%= title %></h1></div>
<div class="card" style="max-width:560px;">
  <% if (error) { %><div class="alert error"><%= error %></div><% } %>
  <form method="POST" action="<%= center.id ? '/daycare/' + center.id + '/edit' : '/daycare/new' %>">
    <label for="name">Name</label>
    <input type="text" id="name" name="name" value="<%= center.name || '' %>" required>
    <label for="address">Address</label>
    <input type="text" id="address" name="address" value="<%= center.address || '' %>">
    <div class="grid grid-2" style="gap:12px;">
      <div>
        <label for="phone">Phone</label>
        <input type="tel" id="phone" name="phone" value="<%= center.phone || '' %>">
      </div>
      <div>
        <label for="contact_person">Contact person</label>
        <input type="text" id="contact_person" name="contact_person" value="<%= center.contact_person || '' %>">
      </div>
    </div>
    <label for="website">Website</label>
    <input type="text" id="website" name="website" value="<%= center.website || '' %>">
    <label for="age_range">Age range served</label>
    <input type="text" id="age_range" name="age_range" value="<%= center.age_range || '' %>" placeholder="e.g. Infant - Preschool">
    <label for="outreach_status">Outreach status</label>
    <select id="outreach_status" name="outreach_status">
      <% Object.entries(STATUS_LABELS).forEach(([val, label]) => { %>
        <option value="<%= val %>" <%= center.outreach_status === val ? 'selected' : '' %>><%= label %></option>
      <% }) %>
    </select>
    <label for="notes">Notes</label>
    <textarea id="notes" name="notes"><%= center.notes || '' %></textarea>
    <div class="form-actions">
      <button type="submit" class="btn">Save</button>
      <a href="/daycare" class="btn ghost">Cancel</a>
    </div>
  </form>
</div>
<%- include('partials/footer') %>
